generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model universities {
  id                 String               @id @default(uuid())
  name               String               @unique
  created_at         DateTime             @default(now())
  
  student_profiles   student_profiles[]
  professor_profiles professor_profiles[]
}

model users {
  id                String   @id @default(uuid())
  github_id         String   @unique
  name              String   
  github_token      String
  role              String   @default("PENDING") 
  created_at        DateTime @default(now())

  student_profile   student_profiles?
  professor_profile professor_profiles?
  
  // [수정됨] 단일 projects 관계에서 N:M 멤버십 관계로 변경
  project_members   project_members[]
}

model student_profiles {
  id             String       @id @default(uuid())
  user_id        String       @unique
  university_id  String
  real_name      String       
  student_number String       
  tech_stack     String[]
  created_at     DateTime     @default(now())

  user       users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  university universities @relation(fields: [university_id], references: [id], onDelete: Restrict)

  enrolled_classes classes[]  @relation("ClassEnrollments")

  @@unique([university_id, student_number])
}

model professor_profiles {
  id               String       @id @default(uuid())
  user_id          String       @unique
  university_id    String
  real_name        String       
  created_at       DateTime     @default(now())

  user             users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  university       universities @relation(fields: [university_id], references: [id], onDelete: Restrict)
  managed_classes  classes[]    @relation("ProfessorToClasses")
}

// [NEW] 팀 기반 아키텍처를 위한 프로젝트-유저 N:M 매핑 테이블
model project_members {
  id         String   @id @default(uuid())
  project_id String
  user_id    String
  role       String   @default("MEMBER") // "LEADER"(개설자) 또는 "MEMBER"(합류자)
  joined_at  DateTime @default(now())

  project projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // 한 유저가 같은 프로젝트에 중복 합류하는 것을 데이터베이스 단에서 원천 차단
  @@unique([project_id, user_id])
}

model projects {
  id                String   @id @default(uuid())
  title             String
  github_url        String
  project_goal      String?  @db.Text
  class_id          String? 
  created_at        DateTime @default(now())

  // AI 분석 데이터 캐싱 및 대시보드 렌더링 최적화 필드
  ai_summary        String?  @db.Text
  ai_evaluation     String?  @db.Text
  last_analyzed_at  DateTime?
  last_commit_count Int      @default(0)

  // [수정됨] 기존의 user_id 의존성을 제거하고 다수 멤버십 참조
  members   project_members[]
  class     classes? @relation(fields: [class_id], references: [id], onDelete: SetNull) 
  
  feedbacks feedbacks[]
}

model feedbacks {
  id             String   @id @default(uuid())
  project_id     String
  content        String   @db.Text
  student_reply  String?  @db.Text
  status         String   @default("PENDING")
  created_at     DateTime @default(now())
  resolved_at    DateTime?

  project        projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model classes {
  id                   String             @id @default(uuid())
  name                 String   
  code                 String             @unique 
  professor_profile_id String   
  created_at           DateTime           @default(now())

  professor            professor_profiles @relation("ProfessorToClasses", fields: [professor_profile_id], references: [id], onDelete: Cascade)
  students             student_profiles[] @relation("ClassEnrollments") 
  projects             projects[]
}